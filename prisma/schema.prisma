// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER & ROLE ─────────────────────────────────────────────
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // Hashed
  nama      String
  role      Role      @default(FRONT_OFFICE)
  status    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dokter    Dokter?
  perawat   Perawat?
  auditLogs AuditLog[]
}

enum Role {
  ADMIN
  FRONT_OFFICE
  DOKTER
  PERAWAT
  APOTEKER
  KASIR
  MANAJER_STOK
}

// ─── DOKTER, PERAWAT & POLI ────────────────────────────────────
model Poli {
  id            String          @id @default(cuid())
  nama          String          @unique
  deskripsi     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  dokters       Dokter[]
  jadwalDokters JadwalDokter[]
  jadwalPerawat JadwalPerawat[]
  pendaftarans  Pendaftaran[]
}

model Dokter {
  id           String         @id @default(cuid())
  userId       String?        @unique
  nama         String
  spesialisasi String
  telepon      String?
  poliId       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  poli         Poli           @relation(fields: [poliId], references: [id])
  jadwalDokter JadwalDokter[]
  pendaftarans Pendaftaran[]
  rekamMedis   RekamMedis[]
}

model Perawat {
  id            String          @id @default(cuid())
  userId        String?         @unique
  nama          String
  telepon       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  jadwalPerawat JadwalPerawat[]
}

// ─── PASIEN ──────────────────────────────────────────────────
model Pasien {
  id            String        @id @default(cuid())
  noRekamMedis  String        @unique
  nik           String        @unique // encrypted in DB
  nama          String
  tanggalLahir  DateTime
  jenisKelamin  JenisKelamin
  alamat        String        // encrypted in DB
  telepon       String        // encrypted in DB
  email         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pendaftarans  Pendaftaran[]
  rekamMedis    RekamMedis[]

  @@index([nik])
  @@index([noRekamMedis])
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

// ─── PENDAFTARAN & ANTRIAN ───────────────────────────────────
model Pendaftaran {
  id             String            @id @default(cuid())
  pasienId       String
  poliId         String
  dokterId       String
  jadwalId       String
  tanggal        DateTime
  status         StatusPendaftaran @default(MENUNGGU)
  sumber         SumberPendaftaran @default(ONLINE)
  
  // Vital Signs (Triage captured by nurse/front office)
  keluhan        String?           @db.Text
  tensiSistolik  Int?
  tensiDiastolik Int?
  beratBadan     Float?            // kg
  tinggiBadan    Float?            // cm
  suhuTubuh      Float?            // celsius
  nadi           Int?              // bpm
  triaseColor    String?           // "MERAH" (Gawat Darurat), "KUNING" (Urgent), "HIJAU" (Non-urgent), "BIRU" (Pemeriksaan rutin)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  pasien         Pasien            @relation(fields: [pasienId], references: [id])
  poli           Poli              @relation(fields: [poliId], references: [id])
  dokter         Dokter            @relation(fields: [dokterId], references: [id])
  jadwal         JadwalDokter      @relation(fields: [jadwalId], references: [id])
  antrian        Antrian?
  rekamMedis     RekamMedis?
  pembayaran     Pembayaran?

  @@index([tanggal, poliId])
  @@index([pasienId])
}

enum StatusPendaftaran {
  MENUNGGU
  DIPERIKSA
  SELESAI
  BATAL
}

enum SumberPendaftaran {
  ONLINE
  OFFLINE
}

model Antrian {
  id             String        @id @default(cuid())
  pendaftaranId  String        @unique
  nomorAntrian   Int
  status         StatusAntrian @default(MENUNGGU)
  dipanggil      DateTime?
  selesai        DateTime?
  createdAt      DateTime      @default(now())

  pendaftaran    Pendaftaran   @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
}

enum StatusAntrian {
  MENUNGGU
  DIPANGGIL
  SELESAI
  BATAL
}

// ─── REKAM MEDIS & RESEP ─────────────────────────────────────
model RekamMedis {
  id             String       @id @default(cuid())
  pasienId       String
  pendaftaranId  String       @unique
  dokterId       String
  subjektif      String       @db.Text
  objektif       String       @db.Text
  assessment     String       @db.Text
  plan           String       @db.Text
  diagnosaICD    String[]     // E.g. ["A09", "J06.9"]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  pasien         Pasien       @relation(fields: [pasienId], references: [id])
  pendaftaran    Pendaftaran  @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
  dokter         Dokter       @relation(fields: [dokterId], references: [id])
  resep          Resep[]

  @@index([pasienId, createdAt])
}

model Resep {
  id           String      @id @default(cuid())
  rekamMedisId String
  status       StatusResep @default(MENUNGGU)
  dipanggil    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  rekamMedis   RekamMedis  @relation(fields: [rekamMedisId], references: [id], onDelete: Cascade)
  items        ResepItem[]
}

enum StatusResep {
  MENUNGGU
  DIPROSES
  PENDING
  SELESAI
}

model ResepItem {
  id       String  @id @default(cuid())
  resepId  String
  obatId   String
  jumlah   Int
  aturan   String  // E.g. "3x1 sesudah makan"
  catatan  String?

  resep    Resep   @relation(fields: [resepId], references: [id], onDelete: Cascade)
  obat     Obat    @relation(fields: [obatId], references: [id])
}

// ─── FARMASI & INVENTARIS ────────────────────────────────────
model Obat {
  id            String      @id @default(cuid())
  kode          String      @unique
  nama          String
  satuan        String      // E.g. "Tablet", "Botol", "Kapsul"
  stok          Int         @default(0)
  stokMinimum   Int         @default(10)
  hargaBeli     Decimal     @db.Decimal(12, 2)
  hargaJual     Decimal     @db.Decimal(12, 2)
  expiredDate   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  resepItems    ResepItem[]
  stokLogs      StokLog[]

  @@index([stok])
}

model StokLog {
  id         String   @id @default(cuid())
  obatId     String
  tipe       TipeStok
  jumlah     Int
  keterangan String   // E.g. "Resep Dokter RM-xxx", "Purchase Order PO-xxx", "Penyesuaian"
  createdAt  DateTime @default(now())

  obat       Obat     @relation(fields: [obatId], references: [id], onDelete: Cascade)
}

enum TipeStok {
  IN
  OUT
}

model AlatKesehatan {
  id              String        @id @default(cuid())
  kode            String        @unique
  nama            String
  jumlah          Int           @default(1)
  kondisi         StatusKondisi @default(BAIK)
  lastMaintenance DateTime?
  nextMaintenance DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum StatusKondisi {
  BAIK
  RUSAK
  PERLU_KALIBRASI
}

model Fasilitas {
  id           String          @id @default(cuid())
  namaRuangan  String          @unique
  status       StatusFasilitas @default(TERSEDIA)
  logKerusakan String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum StatusFasilitas {
  TERSEDIA
  DIGUNAKAN
  PEMELIHARAAN
}

// ─── JADWAL DOKTER & PERAWAT ─────────────────────────────────
model JadwalDokter {
  id           String        @id @default(cuid())
  dokterId     String
  poliId       String
  hari         HariKerja
  jamMulai     String        // E.g. "08:00"
  jamSelesai   String        // E.g. "12:00"
  kuota        Int           @default(20)
  aktif        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  dokter       Dokter        @relation(fields: [dokterId], references: [id])
  poli         Poli          @relation(fields: [poliId], references: [id])
  pendaftarans Pendaftaran[]

  @@unique([dokterId, poliId, hari, jamMulai])
}

model JadwalPerawat {
  id        String   @id @default(cuid())
  perawatId String
  poliId    String
  tanggal   DateTime
  shift     Shift
  createdAt DateTime @default(now())

  perawat   Perawat  @relation(fields: [perawatId], references: [id])
  poli      Poli     @relation(fields: [poliId], references: [id])

  @@unique([perawatId, tanggal, shift])
  @@index([tanggal, poliId])
}

enum HariKerja {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
  MINGGU
}

enum Shift {
  PAGI
  SIANG
  MALAM
}

// ─── KEUANGAN & PEMBAYARAN ───────────────────────────────────
model Pembayaran {
  id               String           @id @default(cuid())
  pendaftaranId    String           @unique
  totalTagihan     Decimal          @db.Decimal(12, 2)
  metodePembayaran MetodePembayaran @default(TUNAI)
  status           StatusPembayaran @default(BELUM_BAYAR)
  noKuitansi       String           @unique
  kasirId          String?
  nomorKartu       String?
  rujukanNo        String?
  asuransiProvider String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  pendaftaran      Pendaftaran      @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
}

enum StatusPembayaran {
  BELUM_BAYAR
  LUNAS
  BATAL
}

enum MetodePembayaran {
  TUNAI
  TRANSFER
  BPJS
  ASURANSI
}

// ─── SISTEM LOGS & NOTIFIKASI ────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  aksi      String   // E.g. "CREATE PASIEN", "DELETE OBAT"
  tabel     String   // E.g. "Pasien", "Obat"
  dataId    String   // E.g. Record ID
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  tipe      TipeNotifikasi
  penerima  String           // Email address / phone number
  pesan     String           @db.Text
  status    StatusNotifikasi @default(PENDING)
  createdAt DateTime         @default(now())
}

enum TipeNotifikasi {
  EMAIL
  SMS
  SYSTEM
}

enum StatusNotifikasi {
  PENDING
  SENT
  FAILED
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
